{
  "name": "qoder-atlas",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Northstar — AI Travel Resolution Engine for the Atlas × Alibaba Cloud hackathon",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "node src/main.ts",
    "test": "node --test --test-concurrency=1",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "acceptance:preflight": "node --experimental-strip-types scripts/acceptance-preflight.ts --manifest fixtures/acceptance/manifests/s1-airline-schedule-change.json",
    "acceptance:run": "node --experimental-strip-types scripts/acceptance-run.ts",
    "acceptance:secret-scan": "node scripts/wave3r-recording-secret-scan.mjs",
    "gate:anti-hardcoding": "node scripts/anti-hardcoding-gate.mjs"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.33.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0"
  }
}
