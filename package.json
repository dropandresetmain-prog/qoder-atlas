{
  "name": "qoder-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "Northstar — AI Travel Resolution Engine for the Atlas × Alibaba Cloud hackathon",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-build-assets.mjs",
    "start": "node dist/main.js",
    "dev": "node src/main.ts",
    "test": "npm run gate:test-boundary && node scripts/run-suite.mjs current",
    "test:current": "node scripts/run-suite.mjs current",
    "test:migration": "node scripts/run-suite.mjs migration",
    "test:legacy": "node scripts/run-suite.mjs legacy",
    "test:suites": "node scripts/test-boundary-gate.mjs --report",
    "gate:test-boundary": "node scripts/test-boundary-gate.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "acceptance:preflight": "node --experimental-strip-types scripts/acceptance-preflight.ts --manifest fixtures/acceptance/manifests/s1-airline-schedule-change.json",
    "acceptance:run": "node --experimental-strip-types scripts/acceptance-run.ts",
    "acceptance:secret-scan": "node scripts/wave3r-recording-secret-scan.mjs",
    "gate:anti-hardcoding": "node scripts/anti-hardcoding-gate.mjs",
    "db:postgres:up": "docker compose -f docker-compose.postgres-test.yml up -d --wait",
    "db:postgres:down": "docker compose -f docker-compose.postgres-test.yml down -v",
    "test:postgres": "node scripts/run-suite.mjs postgres"
  },
  "dependencies": {
    "@langchain/langgraph": "1.4.15",
    "@langchain/langgraph-checkpoint-postgres": "1.0.5",
    "pg": "^8.23.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.23.1",
    "eslint": "^9.33.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0"
  }
}
