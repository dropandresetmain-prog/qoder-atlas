# Environment configuration template — values are examples, never secrets.
# The application MUST start without any optional provider credentials (REPLAY default).
# Variable names below are frozen by the F0 foundation (see docs/ENVIRONMENT.md).

# --- Application ---
# local | dev | demo
APP_ENVIRONMENT=local
# debug | info | warn | error
LOG_LEVEL=info
# HTTP port for the application server (local default 8787).
# Railway and other hosts inject PORT; host PORT wins when both are set.
HTTP_PORT=8787
# External adapter mode: LIVE | RECORD | REPLAY
# Default to REPLAY even when real credentials exist.
# LIVE/RECORD must always be an intentional operator choice.
ADAPTER_MODE=REPLAY
# Where sanitized provider-shaped recordings live (RECORD/REPLAY)
RECORDINGS_DIR=recordings
# Where scenario fixtures live (F3 acceptance scenarios)
FIXTURES_DIR=fixtures
# Boot/reset world composition: full | programme
# Omit to derive from APP_ENVIRONMENT (demo => programme, else full).
# programme skips acceptance-harness scenario trips so the operator world
# is the canonical AnchorEvent programme only.
# WORLD_SEED_MODE=programme

# --- SQLite ---
# ":memory:" is allowed for tests; local runs default to a file under data/
SQLITE_PATH=data/app.sqlite

# ===================================================
# ATLAS — FLIGHT PROVIDER (current / Northstar Minimum)
# Required only for LIVE flight capability.
# ===================================================
ATLAS_ENV=sandbox
ATLAS_BASE_URL=
ATLAS_CLIENT_ID=
ATLAS_CLIENT_SECRET=

# ===================================================
# ALIBABA CLOUD MODEL STUDIO (current / Northstar Minimum)
# Required only for LIVE intelligence (planning, extraction).
# Defaults: BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#           MODEL=qwen-flash
# ===================================================
MODEL_STUDIO_API_KEY=
MODEL_STUDIO_BASE_URL=
MODEL_STUDIO_MODEL=
MODEL_STUDIO_TIMEOUT_MS=

# ===================================================
# NUITÉE CONNECT / liteAPI — HOTEL PROVIDER
# Northstar Minimum hotel provider direction.
# Required only for LIVE hotel search/booking.
#
# Search/content/rates:   https://api.liteapi.travel/v3.0
# Prebook/book/retrieve/cancel: https://book.liteapi.travel/v3.0
# ===================================================
NUITEE_API_KEY=
NUITEE_SEARCH_BASE_URL=https://api.liteapi.travel/v3.0
NUITEE_BOOKING_BASE_URL=https://book.liteapi.travel/v3.0

# ===================================================
# GOOGLE ROUTES — OPTIONAL / NON-BLOCKING
# Used for ground-routing reasoning; replay/fallback when absent.
# ===================================================
GOOGLE_ROUTES_API_KEY=

# ===================================================
# HOTELBEDS TRANSFERS — STRETCH S1 ONLY
# Not required for Northstar Minimum.
# ===================================================
HOTELBEDS_API_KEY=
HOTELBEDS_SHARED_SECRET=
HOTELBEDS_TRANSFERS_BASE_URL=

# ===================================================
# UI IMAGERY - WORLD-SPECIFIC, NOT PRODUCT LOGIC
# Generic projections never name a destination asset. Set these to serve a
# hero image on the traveller surface; leave unset to render no hero.
# The hackathon demo world uses the Singapore-dusk skyline below.
# ===================================================
UI_HERO_IMAGE=
UI_HERO_IMAGE_ALT=
# Optional world affordance: JSON mapping commitment id -> proposed change
# times, so an organiser review opens pre-filled. Unset means no defaults.
DEMO_PROGRAMME_CHANGE_PRESETS=
