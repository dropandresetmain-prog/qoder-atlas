# Environment configuration template — values are examples, never secrets.
# PostgreSQL + PostGIS is the sole normal NORTHSTAR runtime.
# Optional provider credentials are NOT required for REPLAY/local development.

# --- Application ---
# local | dev | demo
APP_ENVIRONMENT=local
# debug | info | warn | error
LOG_LEVEL=info
# HTTP port for the application server (local default 8787).
# Railway and other hosts may inject PORT; host PORT wins when both are set.
HTTP_PORT=8787
# External adapter mode: LIVE | RECORD | REPLAY
# Default to REPLAY even when real credentials exist.
ADAPTER_MODE=REPLAY
# Sanitized provider-shaped recordings used by RECORD/REPLAY.
RECORDINGS_DIR=recordings
# Scenario/demo fixtures.
FIXTURES_DIR=fixtures

# ===================================================
# POSTGRESQL / POSTGIS — CURRENT NORTHSTAR RUNTIME
# ===================================================
# Required application workspace identity.
# Leave blank in committed `.env`; put a stable UUID in `.env.local` for daily
# `npm run dev`. A new UUID is an explicit reset (full dataset + baseline), not
# a normal restart.
PG_TARGET_WORKSPACE_ID=
# Local Docker defaults shown below; override for hosted environments.
PG_TARGET_HOST=localhost
PG_TARGET_PORT=55432
PG_TARGET_DATABASE=northstar_test
PG_TARGET_USER=northstar_test
PG_TARGET_PASSWORD=northstar_test
PG_TARGET_SSL=false
PG_TARGET_POOL_MAX=10
# Optional explicit migration directory override.
# Built runtime already copies SQL migrations during `npm run build`.
# PG_TARGET_MIGRATIONS_DIR=

# Demo dataset for normal product boot. Unset/blank means no dataset provision.
# Copy the AiT path into `.env.local` for daily local development.
# NORTHSTAR_DEMO_DATASET_DIR=fixtures/programmes/ait-summit-2026
# NORTHSTAR_DEMO_DISRUPTION_EVENT_FILE=data/ait-demo-input-pack/scenarios/s1-supplier-disruption/inputs/airline-schedule-change-id7159.json
# NORTHSTAR_DEMO_CONTROLS_FILE=data/ait-demo-input-pack/demo-controls.json
# NORTHSTAR_DEMO_PROGRESSIVE_DELAY_TIMELINE=data/ait-demo-input-pack/scenarios/s2-missed-connection/inputs/progressive-delay-timeline.json

# ===================================================
# LEGACY SQLITE — OFFLINE MIGRATION / HISTORICAL ONLY
# ===================================================
# DO NOT set this as a normal runtime fallback.
# Use only when explicitly exporting/inspecting a historical migration source.
# Never inspect a source-to-preserve through the retired openDatabase() runtime path.
# SQLITE_PATH=data/app.sqlite

# ===================================================
# ATLAS — FLIGHT PROVIDER
# Required only for LIVE flight capability.
# ===================================================
ATLAS_ENV=sandbox
ATLAS_BASE_URL=
ATLAS_CLIENT_ID=
ATLAS_CLIENT_SECRET=

# ===================================================
# INTELLIGENCE PROVIDER
# model_studio | openrouter
# REPLAY must never call either provider even when credentials are present.
# ===================================================
INTELLIGENCE_PROVIDER=model_studio

# ===================================================
# ALIBABA CLOUD MODEL STUDIO
# Preferred WiT/Alibaba live intelligence provider when explicitly enabled.
# Mainland default: https://dashscope.aliyuncs.com/compatible-mode/v1
# International/Singapore: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# ===================================================
MODEL_STUDIO_API_KEY=
MODEL_STUDIO_BASE_URL=
MODEL_STUDIO_MODEL=
MODEL_STUDIO_TIMEOUT_MS=

# ===================================================
# OPENROUTER — OPTIONAL SECOND INTELLIGENCE PROVIDER
# ===================================================
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_MODEL=
OPENROUTER_TIMEOUT_MS=

# ===================================================
# NUITÉE CONNECT / liteAPI — HOTEL PROVIDER
# Required only for LIVE/RECORD hotel capability.
# ===================================================
NUITEE_API_KEY=
NUITEE_SEARCH_BASE_URL=https://api.liteapi.travel/v3.0
NUITEE_BOOKING_BASE_URL=https://book.liteapi.travel/v3.0

# ===================================================
# GOOGLE ROUTES — OPTIONAL / NON-BLOCKING
# ===================================================
GOOGLE_ROUTES_API_KEY=

# ===================================================
# HOTELBEDS TRANSFERS — STRETCH ONLY
# ===================================================
HOTELBEDS_API_KEY=
HOTELBEDS_SHARED_SECRET=
HOTELBEDS_TRANSFERS_BASE_URL=

# ===================================================
# UI / DEMO INPUTS — WORLD-SPECIFIC, NOT PRODUCT LOGIC
# ===================================================
UI_HERO_IMAGE=
UI_HERO_IMAGE_ALT=
# Optional JSON mapping commitment id -> proposed programme change times.
DEMO_PROGRAMME_CHANGE_PRESETS=
