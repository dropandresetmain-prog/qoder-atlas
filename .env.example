# Environment configuration template — values are examples, never secrets.
# The application MUST start without any optional provider credentials (REPLAY default).
# Variable names below are frozen by the F0 foundation (see docs/ENVIRONMENT.md).

# --- Application ---
# local | dev | demo
APP_ENVIRONMENT=local
# debug | info | warn | error
LOG_LEVEL=info
# HTTP port for the application server
HTTP_PORT=8787
# External adapter mode: LIVE | RECORD | REPLAY
ADAPTER_MODE=REPLAY
# Where sanitized provider-shaped recordings live (RECORD/REPLAY)
RECORDINGS_DIR=recordings
# Where scenario fixtures live (F3 acceptance scenarios)
FIXTURES_DIR=fixtures

# --- SQLite ---
# ":memory:" is allowed for tests; local runs default to a file under data/
SQLITE_PATH=data/app.sqlite

# --- Alibaba Cloud Model Studio (optional; required only for LIVE intelligence) ---
MODEL_STUDIO_API_KEY=
MODEL_STUDIO_BASE_URL=
MODEL_STUDIO_MODEL=

# --- Atlas direct API (optional; required only for LIVE flight capability) ---
ATLAS_ENV=sandbox
ATLAS_BASE_URL=
ATLAS_CLIENT_ID=
ATLAS_CLIENT_SECRET=

# --- Google Routes (optional; non-blocking, replay/fallback when absent) ---
GOOGLE_ROUTES_API_KEY=

# --- Nuitée / liteAPI hotel (optional; required only for LIVE hotel capability) ---
# NUITEE_SEARCH_BASE_URL defaults to https://api.liteapi.travel/v3.0 and
# NUITEE_BOOKING_BASE_URL defaults to https://book.liteapi.travel/v3.0 when
# unset; the app starts and replays recordings without any Nuitée
# credentials. LIVE/RECORD fail closed with NOT_CONFIGURED while
# NUITEE_API_KEY is absent. Nuitée is the documented fallback after Duffel
# Stays proved unavailable in Singapore (IMPLEMENTATION_PLAN Section 13);
# see docs/reality-validation/02_HOTEL_PROVIDER_DECISION.md.
NUITEE_API_KEY=
NUITEE_SEARCH_BASE_URL=
NUITEE_BOOKING_BASE_URL=
