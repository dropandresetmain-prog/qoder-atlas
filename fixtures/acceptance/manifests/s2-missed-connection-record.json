{
  "scenarioId": "S2-RECORD",
  "title": "S2 LAX→NRT→SIN missed connection — LIVE planner + LIVE Atlas RECORD proof",
  "mode": "RECORD",
  "globalInputPack": {
    "packId": "ait-global-programme",
    "version": "1.0.0",
    "path": "../packs/global"
  },
  "localInputPack": {
    "packId": "ait-s2",
    "version": "1.0.0",
    "path": "../packs/s2"
  },
  "boundaries": [
    {
      "seam": "atlas.event_ingress",
      "mode": "SIMULATED_EXTERNAL_EVENT",
      "note": "Simulated progressive delay ingress (no LIVE push bus)"
    },
    {
      "seam": "atlas.flight_state_query",
      "mode": "REPLAY",
      "note": "Keep reconciliation REPLAY so progressive RECORD runs stay deterministic on order ZGSYN09"
    },
    {
      "seam": "runtime.missed_flight",
      "mode": "LIVE",
      "note": "traveller-state report through real POST /api/runtime/missed-flight"
    },
    {
      "seam": "model_studio.recovery_planner",
      "mode": "LIVE",
      "note": "Model Studio recovery planning; schema-validated, fail-closed"
    },
    {
      "seam": "atlas.flight_adapter",
      "mode": "RECORD",
      "note": "LIVE sandbox NRT→SIN search through Atlas; sanitized recordings for REPLAY"
    }
  ],
  "requiredEnv": ["MODEL_STUDIO_API_KEY"],
  "requiredProviders": ["atlas", "modelStudio"],
  "expect": {
    "anchorEventIds": ["evt-ait-2026"],
    "travellerIds": ["trv-evt-ait-2026-ait-draft-09"],
    "tripIds": ["trip-trv-evt-ait-2026-ait-draft-09"]
  },
  "routeParams": [
    { "origin": "NRT", "destination": "SIN", "date": "2026-09-29" }
  ],
  "steps": [
    {
      "id": "reset",
      "description": "Deterministic reset/reseed",
      "action": {
        "type": "http",
        "method": "POST",
        "path": "/api/runtime/reset",
        "body": { "at": "2026-09-28T11:00:00-07:00" },
        "expectStatus": 200
      }
    },
    {
      "id": "delay_zg023_final",
      "description": "Simulated final ZG023 retiming that makes ZG053 impossible (REPLAY reconciliation)",
      "action": {
        "type": "simulated_external_event",
        "path": "/api/events/atlas",
        "query": { "at": "2026-09-29T12:00:00+09:00" },
        "body": {
          "eventId": "sim-zg-evt-s2-record-delay-final",
          "orderNo": "ZGSYN09",
          "eventType": "SCHEDULE_CHANGE",
          "eventStatus": 1,
          "eventTime": "2026-09-29T11:50:00+09:00",
          "createTime": "2026-09-29T11:50:00+09:00",
          "airline": "ZG",
          "depTime": "2026-09-28T14:40:00-07:00",
          "pnr": "ZGSYN09"
        },
        "expectStatus": 200
      },
      "assert": [
        { "path": "status", "op": "equals", "expected": "ACCEPTED", "description": "ingress accepted" },
        { "path": "results", "op": "arrayLengthMin", "expected": 1, "description": "reconciled state processed" }
      ]
    },
    {
      "id": "traveller_report",
      "description": "Traveller reports missed NRT→SIN connection",
      "action": {
        "type": "http",
        "method": "POST",
        "path": "/api/runtime/missed-flight",
        "body": {
          "tripId": "trip-trv-evt-ait-2026-ait-draft-09",
          "elementId": "el-trip-trv-evt-ait-2026-ait-draft-09-leg-2",
          "travellerReport": "Hi — stuck at Narita. My LAX flight kept getting delayed and I landed too late for the Zipair connection to Singapore tonight. The airline desk put me on a Scoot flight tomorrow morning around 08:20 that gets in mid-afternoon. I am supposed to be at the hackathon lab in the morning and I present at the finals tomorrow afternoon. My bag is tagged for the morning flight. What do we do — is there anything tonight, or do I need a hotel here?",
          "at": "2026-09-29T17:20:00+09:00"
        },
        "expectStatus": 200,
        "capture": { "caseId": "caseId" }
      },
      "assert": [
        { "path": "caseStatus", "op": "equals", "expected": "ASSESSING", "description": "case opens in assessing" },
        { "path": "missedElementId", "op": "equals", "expected": "el-trip-trv-evt-ait-2026-ait-draft-09-leg-2", "description": "missed NRT→SIN leg resolved" },
        { "path": "directFailureIds", "op": "arrayNotEmpty", "description": "direct failures named" }
      ]
    },
    {
      "id": "observe_case",
      "description": "Observe opened recovery case",
      "action": {
        "type": "observe",
        "path": "/api/cases/{{caseId}}",
        "label": "case_after_missed_connection",
        "expectStatus": 200
      },
      "assert": [
        { "path": "tripId", "op": "equals", "expected": "trip-trv-evt-ait-2026-ait-draft-09", "description": "case on correct trip" },
        { "path": "status", "op": "equals", "expected": "CHANGE_REQUESTED", "description": "awaiting recovery" },
        { "path": "checks", "op": "arrayLengthMin", "expected": 1, "description": "downstream checks present" }
      ]
    },
    {
      "id": "plan",
      "description": "LIVE Model Studio planner + RECORD Atlas search; assert only engine truths",
      "action": {
        "type": "http",
        "method": "POST",
        "path": "/api/runtime/plan",
        "body": {
          "caseId": "{{caseId}}",
          "at": "2026-09-29T18:05:00+09:00"
        },
        "expectStatus": 200
      },
      "assert": [
        { "path": "rounds", "op": "gte", "expected": 1, "description": "planning loop completed at least one round" },
        { "path": "strategies", "op": "arrayLengthMin", "expected": 1, "description": "at least one candidate strategy" },
        { "path": "caseStatus", "op": "equals", "expected": "PLANNING", "description": "case in planning" }
      ]
    },
    {
      "id": "observe_trip",
      "description": "Trip reflects disruption without executed recovery",
      "action": {
        "type": "observe",
        "path": "/api/traveller/trip-trv-evt-ait-2026-ait-draft-09",
        "label": "traveller_trip_after_missed_connection",
        "expectStatus": 200
      },
      "assert": [
        { "path": "status", "op": "equals", "expected": "CHANGE_REQUESTED", "description": "trip disrupted" },
        { "path": "remainderViable", "op": "equals", "expected": "NOT_VIABLE", "description": "remainder not viable until execution" }
      ]
    }
  ]
}
