{
  "scenarioId": "S2",
  "title": "Traveller misses a connection; airline recovery is not good enough",
  "mode": "REPLAY",
  "globalInputPack": {
    "packId": "northstar-global-programme",
    "version": "1.0.0",
    "path": "../packs/global"
  },
  "localInputPack": {
    "packId": "s2-missed-connection",
    "version": "1.0.0",
    "path": "../packs/s2"
  },
  "boundaries": [
    {
      "seam": "runtime.missed_flight",
      "mode": "REPLAY",
      "note": "Traveller-state report through POST /api/runtime/missed-flight"
    },
    {
      "seam": "atlas.flight_adapter",
      "mode": "REPLAY"
    }
  ],
  "requiredEnv": [],
  "requiredProviders": [],
  "expect": {
    "anchorEventIds": ["evt-w3-demo"],
    "travellerIds": [],
    "tripIds": ["trip_a"]
  },
  "routeParams": [],
  "steps": [
    {
      "id": "reset",
      "action": {
        "type": "http",
        "method": "POST",
        "path": "/api/runtime/reset",
        "body": { "at": "2026-09-13T06:00:00+09:00" },
        "expectStatus": 200
      }
    },
    {
      "id": "trigger",
      "description": "Traveller reports missed connection",
      "action": {
        "type": "http",
        "method": "POST",
        "path": "/api/runtime/missed-flight",
        "body": {
          "tripId": "trip_a",
          "elementId": "el_a_flight_out",
          "travellerReport": "My connecting flight was delayed and I missed the next leg.",
          "at": "2026-09-13T07:00:00+09:00"
        },
        "capture": { "caseId": "caseId" },
        "expectStatus": 200
      }
    },
    {
      "id": "observe_case",
      "action": {
        "type": "observe",
        "path": "/api/cases/{{caseId}}",
        "expectStatus": 200
      }
    }
  ]
}
