{
  "scenarioId": "S2",
  "title": "Missed connection after late inbound",
  "mode": "REPLAY",
  "globalInputPack": {
    "packId": "ait-global-programme",
    "version": "1.0.0",
    "path": "../packs/global"
  },
  "localInputPack": {
    "packId": "ait-s2",
    "version": "1.0.0",
    "path": "../packs/s2"
  },
  "boundaries": [
    {
      "seam": "runtime.missed_flight",
      "mode": "REPLAY",
      "note": "Traveller-state report through POST /api/runtime/missed-flight"
    },
    {
      "seam": "atlas.flight_adapter",
      "mode": "REPLAY",
      "note": "Provider reprotection state stays REPLAY"
    }
  ],
  "requiredEnv": [],
  "requiredProviders": [],
  "expect": {
    "anchorEventIds": [
      "evt-ait-2026"
    ],
    "travellerIds": [
      "trv-evt-ait-2026-ait-draft-09"
    ],
    "tripIds": [
      "trip-trv-evt-ait-2026-ait-draft-09"
    ]
  },
  "routeParams": [],
  "steps": [
    {
      "id": "reset",
      "description": "Deterministic reset/reseed",
      "action": {
        "type": "http",
        "method": "POST",
        "path": "/api/runtime/reset",
        "body": {
          "at": "2026-09-29T18:00:00+08:00"
        },
        "expectStatus": 200
      }
    },
    {
      "id": "traveller_report",
      "description": "Traveller reports missed KUL->SIN connection (pack msg-ait-s2-001); explicit elementId because the report lands after the leg's scheduled departure (DR-7 seam)",
      "action": {
        "type": "http",
        "method": "POST",
        "path": "/api/runtime/missed-flight",
        "body": {
          "tripId": "trip-trv-evt-ait-2026-ait-draft-09",
          "elementId": "el-trip-trv-evt-ait-2026-ait-draft-09-leg-2",
          "travellerReport": "Hi - stuck in KL. My flight out of Sydney left about five hours late (weather holding) and I missed my connection to Singapore. The airline desk rebooked me on a flight tomorrow morning at 8:10, landing just after 9. I present at the hackathon finals tomorrow afternoon and I am supposed to be at the lab in the morning too. My suitcase went on the morning flight apparently. What do we do?",
          "at": "2026-09-29T19:40:00+08:00"
        },
        "expectStatus": 200,
        "capture": {
          "caseId": "caseId"
        }
      }
    },
    {
      "id": "observe_case",
      "description": "Observe opened recovery case",
      "action": {
        "type": "observe",
        "path": "/api/cases/{{caseId}}",
        "label": "case_after_missed_connection",
        "expectStatus": 200
      }
    }
  ]
}
