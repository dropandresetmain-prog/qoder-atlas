    {
      "id": "reset",
      "description": "Deterministic reset/reseed",
      "action": {
        "type": "http",
        "method": "POST",
        "path": "/api/runtime/reset",
        "body": {
          "at": "2026-09-21T09:00:00+08:00"
        },
        "expectStatus": 200
      }
    },
    {
      "id": "notify_mn218_hero",
      "description": "Simulated MN218 schedule-change notification for hero booking MNSYN14; reconciliation read returns the retimed 1 Oct schedule as CONNECTED state",
      "action": {
        "type": "simulated_external_event",
        "path": "/api/events/atlas",
        "query": {
          "at": "2026-09-21T09:45:00+08:00"
        },
        "body": {
          "eventId": "sim-mn-evt-20260921-001-mnsyn14",
          "orderNo": "MNSYN14",
          "eventType": "SCHEDULE_CHANGE",
          "eventStatus": 1,
          "eventTime": "2026-09-21T09:40:00+08:00",
          "createTime": "2026-09-21T09:40:00+08:00",
          "airline": "MN",
          "depTime": "2026-10-01T06:00:00+08:00",
          "pnr": "MNSYN14"
        },
        "capture": {
          "heroCaseId": "results.0.caseId",
          "heroTripId": "results.0.tripId"
        },
        "expectStatus": 200
      },
      "assert": [
        {
          "description": "notify_mn218_hero: ingress accepts the provider-shaped event",
          "path": "status",
          "op": "equals",
          "expected": "ACCEPTED"
        },
        {
          "description": "notify_mn218_hero: provider state reconciliation outranks the ASSERTED push (fact precedence intact)",
          "path": "results.0.processed.mutationAccepted",
          "op": "falsy"
        },
        {
          "description": "notify_mn218_hero: outrank is evidenced by an explicit FACT_OUTRANKED issue",
          "path": "results.0.processed.mutationIssues.0.code",
          "op": "equals",
          "expected": "FACT_OUTRANKED"
        },
        {
          "description": "notify_mn218_hero: a recovery case exists for the affected trip",
          "path": "results.0.caseId",
          "op": "exists"
        }
      ]
    },
