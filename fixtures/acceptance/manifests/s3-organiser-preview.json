{
  "scenarioId": "S3",
  "title": "Organiser event-side preview",
  "mode": "REPLAY",
  "globalInputPack": {
    "packId": "ait-global-programme",
    "version": "1.0.0",
    "path": "../packs/global"
  },
  "localInputPack": {
    "packId": "ait-s3",
    "version": "1.0.0",
    "path": "../packs/s3"
  },
  "boundaries": [
    {
      "seam": "programme.event_change",
      "mode": "REPLAY",
      "note": "Mutation-free counterfactual preview through programme HTTP"
    }
  ],
  "requiredEnv": [],
  "requiredProviders": [],
  "expect": {
    "anchorEventIds": [
      "evt-ait-2026"
    ],
    "travellerIds": [
      "trv-evt-ait-2026-ait-draft-04",
      "trv-evt-ait-2026-ait-draft-20",
      "trv-evt-ait-2026-ait-draft-02"
    ],
    "tripIds": []
  },
  "routeParams": [],
  "steps": [
    {
      "id": "reset",
      "description": "Deterministic reset/reseed",
      "action": {
        "type": "http",
        "method": "POST",
        "path": "/api/runtime/reset",
        "body": {
          "at": "2026-09-22T10:00:00+08:00"
        },
        "expectStatus": 200
      }
    },
    {
      "id": "preview",
      "description": "Counterfactual: move future-provocation into the 09:50-10:10 Day-1 slot (pack preview-request)",
      "action": {
        "type": "http",
        "method": "POST",
        "path": "/api/programme/evt-ait-2026/change-preview",
        "body": {
          "commitmentId": "cmt-ait-d1-future-provocation",
          "changeKind": "RESCHEDULED",
          "newStartsAt": "2026-10-01T09:50:00+08:00",
          "newEndsAt": "2026-10-01T10:10:00+08:00",
          "at": "2026-09-22T11:05:00+08:00"
        },
        "expectStatus": 200
      }
    },
    {
      "id": "observe_programme",
      "action": {
        "type": "observe",
        "path": "/api/programme/evt-ait-2026",
        "label": "programme_after_preview",
        "expectStatus": 200
      }
    }
  ]
}
