{
  "scenarioId": "S3",
  "title": "Organiser RESCHEDULE preview/commit for headline interview (continuity-aligned)",
  "mode": "REPLAY",
  "globalInputPack": {
    "packId": "ait-global-programme",
    "version": "1.0.0",
    "path": "../packs/global"
  },
  "localInputPack": {
    "packId": "ait-s3",
    "version": "1.0.0",
    "path": "../packs/s3"
  },
  "boundaries": [
    {
      "seam": "programme.change_preview",
      "mode": "REPLAY",
      "note": "Organiser Preview through real programme HTTP surface"
    },
    {
      "seam": "programme.change_commit",
      "mode": "REPLAY",
      "note": "Organiser Commit through real programme HTTP surface"
    }
  ],
  "requiredEnv": [],
  "requiredProviders": [],
  "expect": {
    "anchorEventIds": ["evt-ait-2026"],
    "travellerIds": ["trv-evt-ait-2026-ait-draft-14"],
    "tripIds": ["trip-trv-evt-ait-2026-ait-draft-14"]
  },
  "routeParams": [],
  "steps": [
    {
      "id": "reset",
      "description": "Deterministic reset/reseed (standalone S3 only — continuous proof lives in s1-s3-continuity.json)",
      "action": {
        "type": "http",
        "method": "POST",
        "path": "/api/runtime/reset",
        "body": { "at": "2026-09-22T10:00:00+08:00" },
        "expectStatus": 200
      }
    },
    {
      "id": "organiser_preview",
      "description": "Preview RESCHEDULE headline interview to 15:30–16:00 without authoritative mutation",
      "action": {
        "type": "ui_action",
        "kind": "organiser_preview",
        "params": {
          "anchorEventId": "evt-ait-2026",
          "commitmentId": "cmt-ait-d1-headline-interview",
          "changeKind": "RESCHEDULED",
          "newStartsAt": "2026-10-01T15:30:00+08:00",
          "newEndsAt": "2026-10-01T16:00:00+08:00",
          "at": "2026-09-22T11:05:00+08:00"
        },
        "expectStatus": 200
      },
      "assert": [
        { "path": "totalTravellers", "op": "equals", "expected": 67, "description": "full roster blast radius" },
        { "path": "affected", "op": "arrayLengthMin", "expected": 2, "description": "interviewer and speaker linked" },
        { "path": "affected.1.tripId", "op": "equals", "expected": "trip-trv-evt-ait-2026-ait-draft-14", "description": "Sarah Lim trip linked to headline interview" }
      ]
    },
    {
      "id": "observe_programme_mid",
      "description": "Preview mutated nothing authoritative",
      "action": {
        "type": "observe",
        "path": "/api/programme/evt-ait-2026",
        "label": "programme_between_preview_and_commit",
        "expectStatus": 200
      },
      "assert": [
        { "path": "summary.disrupted", "op": "equals", "expected": 3, "description": "preview leaves baseline disrupted count unchanged (truthful post-import viability)" }
      ]
    },
    {
      "id": "organiser_commit",
      "description": "Commit RESCHEDULE fan-out",
      "action": {
        "type": "ui_action",
        "kind": "organiser_commit",
        "params": {
          "anchorEventId": "evt-ait-2026",
          "commitmentId": "cmt-ait-d1-headline-interview",
          "changeKind": "RESCHEDULED",
          "newStartsAt": "2026-10-01T15:30:00+08:00",
          "newEndsAt": "2026-10-01T16:00:00+08:00",
          "at": "2026-09-22T11:20:00+08:00"
        },
        "expectStatus": 200,
        "capture": { "caseId": "processedSignals.1.caseId" }
      },
      "assert": [
        { "path": "accepted", "op": "truthy", "description": "commit accepted" },
        { "path": "processedSignals", "op": "arrayLengthMin", "expected": 2, "description": "fan-out signals for interviewer and speaker" },
        { "path": "processedSignals.1.tripId", "op": "equals", "expected": "trip-trv-evt-ait-2026-ait-draft-14", "description": "fan-out targets headline speaker trip" }
      ]
    },
    {
      "id": "observe_case_final",
      "description": "Fan-out case exists for the linked trip",
      "action": {
        "type": "observe",
        "path": "/api/cases/{{caseId}}",
        "label": "case_after_commit",
        "expectStatus": 200
      },
      "assert": [
        { "path": "tripId", "op": "equals", "expected": "trip-trv-evt-ait-2026-ait-draft-14", "description": "case belongs to headline speaker trip" }
      ]
    }
  ]
}
