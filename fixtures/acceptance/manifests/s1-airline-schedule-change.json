{
  "scenarioId": "S1",
  "title": "Airline schedule change — Groups A (accept) / C (critical NOT_VIABLE); CGK pack pending shared rebuild",
  "mode": "SIMULATED_EXTERNAL_EVENT",
  "globalInputPack": {
    "packId": "ait-global-programme",
    "version": "1.0.0",
    "path": "../packs/global"
  },
  "localInputPack": {
    "packId": "ait-s1",
    "version": "1.0.0",
    "path": "../packs/s1"
  },
  "boundaries": [
    {
      "seam": "atlas.event_ingress",
      "mode": "SIMULATED_EXTERNAL_EVENT",
      "note": "Runnable against b7d80aa KUL MN218 seed; scenario pack describes CGK MN310 target"
    },
    {
      "seam": "atlas.flight_state_query",
      "mode": "REPLAY",
      "note": "SIMULATED schedule-change provider-state recordings"
    },
    {
      "seam": "atlas.flight_adapter",
      "mode": "REPLAY",
      "note": "Downstream adapter REPLAY"
    }
  ],
  "requiredEnv": [],
  "requiredProviders": [],
  "expect": {
    "anchorEventIds": ["evt-ait-2026"],
    "travellerIds": [
      "trv-evt-ait-2026-ait-draft-14",
      "trv-evt-ait-2026-ait-draft-10",
      "trv-evt-ait-2026-ait-draft-11",
      "trv-evt-ait-2026-ait-draft-30"
    ],
    "tripIds": [
      "trip-trv-evt-ait-2026-ait-draft-14",
      "trip-trv-evt-ait-2026-ait-draft-10",
      "trip-trv-evt-ait-2026-ait-draft-11",
      "trip-trv-evt-ait-2026-ait-draft-30"
    ]
  },
  "routeParams": [
    { "origin": "KUL", "destination": "SIN", "date": "2026-10-01" }
  ],
  "steps": [
    {
      "id": "reset",
      "description": "Deterministic reset/reseed",
      "action": {
        "type": "http",
        "method": "POST",
        "path": "/api/runtime/reset",
        "body": { "at": "2026-09-21T09:00:00+08:00" },
        "expectStatus": 200
      }
    },
    {
      "id": "notify_group_c",
      "description": "Group C critical traveller schedule-change (MNSYN14)",
      "action": {
        "type": "simulated_external_event",
        "path": "/api/events/atlas",
        "query": { "at": "2026-09-21T09:45:00+08:00" },
        "body": {
          "eventId": "sim-mn-evt-20260921-001-mnsyn14",
          "orderNo": "MNSYN14",
          "eventType": "SCHEDULE_CHANGE",
          "eventStatus": 1,
          "eventTime": "2026-09-21T09:40:00+08:00",
          "createTime": "2026-09-21T09:40:00+08:00",
          "airline": "MN",
          "depTime": "2026-10-01T06:00:00+08:00",
          "pnr": "MNSYN14"
        },
        "capture": { "heroCaseId": "results.0.caseId", "heroTripId": "results.0.tripId" },
        "expectStatus": 200
      },
      "assert": [
        { "path": "status", "op": "equals", "expected": "ACCEPTED", "description": "ingress accepted" },
        { "path": "results.0.processed.mutationAccepted", "op": "truthy", "description": "mutation accepted" },
        { "path": "results.0.processed.constraintEvaluations.0.status", "op": "equals", "expected": "FAIL", "description": "headline buffer fails" },
        { "path": "results.0.processed.constraintEvaluations.0.evidence", "op": "contains", "expected": "required 360min", "description": "360min evidence" }
      ]
    },
    {
      "id": "notify_group_a_draft10",
      "description": "Group A (MNSYN10)",
      "action": {
        "type": "simulated_external_event",
        "path": "/api/events/atlas",
        "query": { "at": "2026-09-21T09:47:00+08:00" },
        "body": {
          "eventId": "sim-mn-evt-20260921-001-mnsyn10",
          "orderNo": "MNSYN10",
          "eventType": "SCHEDULE_CHANGE",
          "eventStatus": 1,
          "eventTime": "2026-09-21T09:40:00+08:00",
          "createTime": "2026-09-21T09:40:00+08:00",
          "airline": "MN",
          "depTime": "2026-10-01T06:00:00+08:00",
          "pnr": "MNSYN10"
        },
        "expectStatus": 200
      },
      "assert": [
        { "path": "results.0.processed.constraintEvaluations.0.status", "op": "equals", "expected": "PASS", "description": "afternoon commitment viable" }
      ]
    },
    {
      "id": "notify_group_a_draft11",
      "description": "Group A (MNSYN11)",
      "action": {
        "type": "simulated_external_event",
        "path": "/api/events/atlas",
        "query": { "at": "2026-09-21T09:48:00+08:00" },
        "body": {
          "eventId": "sim-mn-evt-20260921-001-mnsyn11",
          "orderNo": "MNSYN11",
          "eventType": "SCHEDULE_CHANGE",
          "eventStatus": 1,
          "eventTime": "2026-09-21T09:40:00+08:00",
          "createTime": "2026-09-21T09:40:00+08:00",
          "airline": "MN",
          "depTime": "2026-10-01T06:00:00+08:00",
          "pnr": "MNSYN11"
        },
        "expectStatus": 200
      },
      "assert": [
        { "path": "results.0.processed.constraintEvaluations.0.status", "op": "equals", "expected": "PASS", "description": "panel viable" }
      ]
    },
    {
      "id": "notify_group_a_draft30",
      "description": "Group A (MNSYN30)",
      "action": {
        "type": "simulated_external_event",
        "path": "/api/events/atlas",
        "query": { "at": "2026-09-21T09:49:00+08:00" },
        "body": {
          "eventId": "sim-mn-evt-20260921-001-mnsyn30",
          "orderNo": "MNSYN30",
          "eventType": "SCHEDULE_CHANGE",
          "eventStatus": 1,
          "eventTime": "2026-09-21T09:40:00+08:00",
          "createTime": "2026-09-21T09:40:00+08:00",
          "airline": "MN",
          "depTime": "2026-10-01T06:00:00+08:00",
          "pnr": "MNSYN30"
        },
        "expectStatus": 200
      },
      "assert": [
        { "path": "results.0.processed.constraintEvaluations.0.status", "op": "equals", "expected": "PASS", "description": "panel viable" }
      ]
    },
    {
      "id": "observe_group_c",
      "description": "Group C NOT_VIABLE",
      "action": {
        "type": "observe",
        "path": "/api/traveller/trip-trv-evt-ait-2026-ait-draft-14",
        "label": "group_c_trip",
        "expectStatus": 200
      },
      "assert": [
        { "path": "remainderViable", "op": "equals", "expected": "NOT_VIABLE", "description": "critical traveller not viable" }
      ]
    },
    {
      "id": "observe_group_a",
      "description": "Group A VIABLE",
      "action": {
        "type": "observe",
        "path": "/api/traveller/trip-trv-evt-ait-2026-ait-draft-10",
        "label": "group_a_trip",
        "expectStatus": 200
      },
      "assert": [
        { "path": "remainderViable", "op": "equals", "expected": "VIABLE", "description": "airline reprotection accepted" }
      ]
    }
  ]
}
