{
  "scenarioId": "S1",
  "title": "Airline schedule change affects several speakers",
  "mode": "SIMULATED_EXTERNAL_EVENT",
  "globalInputPack": {
    "packId": "ait-global-programme",
    "version": "1.0.0",
    "path": "../packs/global"
  },
  "localInputPack": {
    "packId": "ait-s1",
    "version": "1.0.0",
    "path": "../packs/s1"
  },
  "boundaries": [
    {
      "seam": "atlas.event_ingress",
      "mode": "SIMULATED_EXTERNAL_EVENT",
      "note": "Provider-shaped schedule/cancel events via POST /api/events/atlas"
    },
    {
      "seam": "atlas.flight_adapter",
      "mode": "REPLAY",
      "note": "Downstream adapter REPLAY unless LIVE acceptance overrides"
    }
  ],
  "requiredEnv": [],
  "requiredProviders": [],
  "expect": {
    "anchorEventIds": [
      "evt-ait-2026"
    ],
    "travellerIds": [
      "trv-evt-ait-2026-ait-draft-14",
      "trv-evt-ait-2026-ait-draft-15",
      "trv-evt-ait-2026-ait-draft-13"
    ],
    "tripIds": [
      "trip-trv-evt-ait-2026-ait-draft-14",
      "trip-trv-evt-ait-2026-ait-draft-15",
      "trip-trv-evt-ait-2026-ait-draft-13"
    ]
  },
  "routeParams": [],
  "steps": [
    {
      "id": "reset",
      "description": "Deterministic reset/reseed",
      "action": {
        "type": "http",
        "method": "POST",
        "path": "/api/runtime/reset",
        "body": {
          "at": "2026-09-21T09:00:00+08:00"
        },
        "expectStatus": 200
      }
    },
    {
      "id": "trigger_mn218_hero",
      "description": "Simulated MN218 schedule change for hero booking MNSYN14",
      "action": {
        "type": "simulated_external_event",
        "path": "/api/events/atlas",
        "query": {
          "at": "2026-09-21T09:45:00+08:00"
        },
        "body": {
          "eventId": "sim-mn-evt-20260921-001-mnsyn14",
          "orderNo": "MNSYN14",
          "eventType": "SCHEDULE_CHANGE",
          "eventStatus": 1,
          "eventTime": "2026-09-21T09:40:00+08:00",
          "createTime": "2026-09-21T09:40:00+08:00",
          "airline": "MN",
          "depTime": "2026-09-30T06:15:00+08:00",
          "pnr": "MNSYN14"
        },
        "capture": {
          "caseId": "results.0.caseId",
          "tripId": "results.0.tripId"
        },
        "expectStatus": 200
      }
    },
    {
      "id": "trigger_mn218_peer",
      "description": "Same schedule-change shape for peer booking MNSYN15 (multi-trip fan-out)",
      "action": {
        "type": "simulated_external_event",
        "path": "/api/events/atlas",
        "query": {
          "at": "2026-09-21T09:46:00+08:00"
        },
        "body": {
          "eventId": "sim-mn-evt-20260921-001-mnsyn15",
          "orderNo": "MNSYN15",
          "eventType": "SCHEDULE_CHANGE",
          "eventStatus": 1,
          "eventTime": "2026-09-21T09:40:00+08:00",
          "createTime": "2026-09-21T09:40:00+08:00",
          "airline": "MN",
          "depTime": "2026-09-30T06:15:00+08:00",
          "pnr": "MNSYN15"
        },
        "expectStatus": 200
      }
    },
    {
      "id": "trigger_mn204",
      "description": "Simulated MN204 cancellation for booking MNSYN13",
      "action": {
        "type": "simulated_external_event",
        "path": "/api/events/atlas",
        "query": {
          "at": "2026-09-21T09:55:00+08:00"
        },
        "body": {
          "eventId": "sim-mn-evt-20260921-002",
          "orderNo": "MNSYN13",
          "eventType": "CANCELLATION",
          "eventStatus": 1,
          "eventTime": "2026-09-21T09:55:00+08:00",
          "createTime": "2026-09-21T09:55:00+08:00",
          "airline": "MN",
          "depTime": "2026-09-30T08:35:00+08:00",
          "pnr": "MNSYN13"
        },
        "expectStatus": 200
      }
    },
    {
      "id": "observe_case",
      "description": "Observe opened recovery case",
      "action": {
        "type": "observe",
        "path": "/api/cases/{{caseId}}",
        "label": "case_after_simulated_ingress",
        "expectStatus": 200
      }
    }
  ]
}
