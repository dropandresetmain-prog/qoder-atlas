{
  "scenarioId": "S8",
  "title": "Can I travel with the other speakers?",
  "mode": "REPLAY",
  "globalInputPack": {
    "packId": "ait-global-programme",
    "version": "1.0.0",
    "path": "../packs/global"
  },
  "localInputPack": {
    "packId": "ait-s8",
    "version": "1.0.0",
    "path": "../packs/s8"
  },
  "boundaries": [
    {
      "seam": "traveller.change_request",
      "mode": "REPLAY",
      "note": "Structured ChangeRequest with a cross-traveller association target through resolution HTTP"
    }
  ],
  "requiredEnv": [],
  "requiredProviders": [],
  "expect": {
    "anchorEventIds": [
      "evt-ait-2026"
    ],
    "travellerIds": [
      "trv-evt-ait-2026-ait-draft-30",
      "trv-evt-ait-2026-ait-draft-10",
      "trv-evt-ait-2026-ait-draft-11"
    ],
    "tripIds": [
      "trip-trv-evt-ait-2026-ait-draft-30",
      "trip-trv-evt-ait-2026-ait-draft-10",
      "trip-trv-evt-ait-2026-ait-draft-11"
    ]
  },
  "routeParams": [],
  "steps": [
    {
      "id": "reset",
      "description": "Deterministic reset/reseed",
      "action": {
        "type": "http",
        "method": "POST",
        "path": "/api/runtime/reset",
        "body": {
          "at": "2026-09-19T10:00:00+08:00"
        },
        "expectStatus": 200
      }
    },
    {
      "id": "change_request",
      "description": "Traveller asks to travel with two peer speakers; the requested grouping is assessed against TRANSPORT_CONCENTRATION policy",
      "action": {
        "type": "http",
        "method": "POST",
        "path": "/api/resolution/change-request",
        "body": {
          "request": {
            "id": "cr-ait-s8-001",
            "tripId": "trip-trv-evt-ait-2026-ait-draft-30",
            "travellerId": "trv-evt-ait-2026-ait-draft-30",
            "sourceId": "src-acceptance-manifest",
            "authority": "ASSERTED",
            "issuedAt": "2026-09-19T10:05:00+08:00",
            "intentKind": "CHANGE_TRANSPORT_SCHEDULE",
            "urgency": "SOFT_PREFERENCE",
            "utterance": "Can I travel with the other speakers on the same flight?",
            "target": {
              "travelWithTravellerIds": [
                "trv-evt-ait-2026-ait-draft-10",
                "trv-evt-ait-2026-ait-draft-11"
              ]
            }
          },
          "at": "2026-09-19T10:05:00+08:00"
        },
        "expectStatus": 200,
        "capture": {
          "caseId": "caseId"
        }
      },
      "assert": [
        {
          "description": "association request accepted",
          "path": "accepted",
          "op": "truthy"
        },
        {
          "description": "peer travellers identified",
          "path": "implications",
          "op": "contains",
          "expected": "travel association requested with 2 peer traveller(s): trv-evt-ait-2026-ait-draft-10, trv-evt-ait-2026-ait-draft-11"
        },
        {
          "description": "candidate grouping evaluated against the configured TRANSPORT_CONCENTRATION policy",
          "path": "implications",
          "op": "contains",
          "expected": "transport concentration policy: requested association groups 3 critical traveller(s), exceeding the limit of 2; the grouping is NOT permitted"
        },
        {
          "description": "violation recorded as an alternative-required uncertainty",
          "path": "uncertainties",
          "op": "arrayNotEmpty"
        },
        {
          "description": "violation uncertainty is HIGH severity",
          "path": "uncertainties.0.severity",
          "op": "equals",
          "expected": "HIGH"
        },
        {
          "description": "violation uncertainty names the alternative requirement",
          "path": "uncertainties.0.statement",
          "op": "contains",
          "expected": "an alternative arrangement is required"
        },
        {
          "description": "request opens the case but does not resolve it",
          "path": "caseStatus",
          "op": "equals",
          "expected": "ASSESSING"
        }
      ]
    },
    {
      "id": "observe_case",
      "description": "Observe opened recovery case still open for alternative planning",
      "action": {
        "type": "observe",
        "path": "/api/cases/{{caseId}}",
        "label": "case_after_change_request",
        "expectStatus": 200
      },
      "assert": [
        {
          "description": "case remains open for alternative planning (read-model surfaces the change request)",
          "path": "status",
          "op": "equals",
          "expected": "CHANGE_REQUESTED"
        },
        {
          "description": "case is a recovery case on the subject trip",
          "path": "tripId",
          "op": "equals",
          "expected": "trip-trv-evt-ait-2026-ait-draft-30"
        }
      ]
    }
  ]
}
