{
  "scenarioId": "S6",
  "title": "Can I switch hotels? My partner is joining.",
  "mode": "REPLAY",
  "globalInputPack": {
    "packId": "northstar-global-programme",
    "version": "1.0.0",
    "path": "../packs/global"
  },
  "localInputPack": {
    "packId": "s6-switch-hotels",
    "version": "1.0.0",
    "path": "../packs/s6"
  },
  "boundaries": [
    {
      "seam": "traveller.change_request",
      "mode": "REPLAY",
      "note": "Stretch scenario — hotel switch requested via traveller text"
    },
    {
      "seam": "nuitee.hotel_adapter",
      "mode": "REPLAY"
    }
  ],
  "requiredEnv": [],
  "requiredProviders": [],
  "expect": {
    "anchorEventIds": ["evt-w3-demo"],
    "travellerIds": ["trv-evt-w3-demo-draft-6"],
    "tripIds": ["trip-trv-evt-w3-demo-draft-6"]
  },
  "routeParams": [],
  "steps": [
    {
      "id": "reset",
      "action": {
        "type": "http",
        "method": "POST",
        "path": "/api/runtime/reset",
        "body": { "at": "2026-09-04T11:00:00+00:00" },
        "expectStatus": 200
      }
    },
    {
      "id": "traveller_request",
      "action": {
        "type": "traveller_message",
        "travellerId": "trv-evt-w3-demo-draft-6",
        "tripId": "trip-trv-evt-w3-demo-draft-6",
        "text": "Can I switch hotels? My partner is joining and we need a different room.",
        "at": "2026-09-04T12:00:00+00:00",
        "capture": { "caseId": "caseId" },
        "expectStatus": 200
      }
    },
    {
      "id": "observe_case",
      "action": {
        "type": "observe",
        "path": "/api/cases/{{caseId}}",
        "expectStatus": 200
      }
    }
  ]
}
