      "trip-trv-evt-ait-2026-ait-draft-31"
    ]
  },
  "routeParams": [],
  "steps": [
    {
      "id": "reset",
      "description": "Deterministic reset/reseed",
      "action": {
        "type": "http",
        "method": "POST",
        "path": "/api/runtime/reset",
        "body": {
          "at": "2026-09-22T10:00:00+08:00"
        },
        "expectStatus": 200
      }
    },
    {
      "id": "change_request",
      "action": {
        "type": "http",
        "method": "POST",
        "path": "/api/resolution/change-request",
        "body": {
          "request": {
            "id": "cr-ait-s6-001",
            "tripId": "trip-trv-evt-ait-2026-ait-draft-31",
            "travellerId": "trv-evt-ait-2026-ait-draft-31",
            "sourceId": "src-acceptance-manifest",
            "authority": "ASSERTED",
            "issuedAt": "2026-09-22T10:05:00+08:00",
            "intentKind": "CHANGE_STAY",
            "urgency": "HARD_INSTRUCTION",
            "utterance": "Can I switch hotels? My partner is joining.",
            "target": {
              "preferredStayPlaceId": "place-hotel-harbourline",
              "guests": 2
            },
            "fundingDeclaration": "TRAVELLER_FUNDED"
          },
          "at": "2026-09-22T10:05:00+08:00"
        },
        "expectStatus": 200,
        "capture": {
          "caseId": "caseId"
        }
      }
    },
    {
      "id": "observe_case",
      "description": "Observe opened recovery case",
      "action": {
        "type": "observe",
        "path": "/api/cases/{{caseId}}",
        "label": "case_after_change_request",
        "expectStatus": 200
      }
    }
