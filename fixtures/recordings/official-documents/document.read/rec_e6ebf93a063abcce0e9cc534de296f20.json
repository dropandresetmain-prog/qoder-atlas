      <ul><li id=\"menu-item-191\" class=\"trp-language-switcher-container menu-item menu-item-type-post_type menu-item-object-language_switcher menu-item-has-children current-language-menu-item menu-item-191\"><a href=\"https://gateway-hotel.co.jp/en/guest\"><span data-no-translation><span class=\"trp-ls-language-name\">EN</span></span></a>\n<ul class=\"sub-menu\">\n\t<li id=\"menu-item-190\" class=\"trp-language-switcher-container menu-item menu-item-type-post_type menu-item-object-language_switcher menu-item-190\"><a href=\"https://gateway-hotel.co.jp/guest/\"><span data-no-translation><span class=\"trp-ls-language-name\">JA</span></span></a></li>\n\t<li id=\"menu-item-188\" class=\"trp-language-switcher-container menu-item menu-item-type-post_type menu-item-object-language_switcher menu-item-188\"><a href=\"https://gateway-hotel.co.jp/zh/guest/\"><span data-no-translation><span class=\"trp-ls-language-name\">ZH</span></span></a></li>\n</ul>\n</li>\n</ul>                    </div>\n  </div></li>\n  </ul>\n<input type=\"checkbox\" id=\"menu\" />\n<label for=\"menu\" class=\"menu\"> <span></span> <span></span> <span></span> </label>\n<nav class=\"nav\">\n<div class=\"header_logo\"><a href=\"https://gateway-hotel.co.jp/en/\"><img src=\"https://gateway-hotel.co.jp/wp/wp-content/themes/narita2025/img/logo_on.webp\" alt=\"成田ゲートウェイホテル\"></a></div>\n<nav>\n  <ul class=\"head_menu\">\n    <li><a href=\"https://gateway-hotel.co.jp/en/room\">Accommodation</a></li>\n    <li><a href=\"https://gateway-hotel.co.jp/en/restaurant\">restaurant</a></li>\n    <li><a href=\"https://gateway-hotel.co.jp/en/guest\">Facility Information</a></li>\n    <li><a href=\"https://gateway-hotel.co.jp/en/access\">access</a></li>\n    <li><a href=\"https://gateway-hotel.co.jp/en/surround\">Tourist Information</a></li>\n\t  <li><div class=\"box_cont add_side sp_none\">\n                    <div class=\"navi-in\"><span class=\"h_icon h_icon5_sp\"><i class=\"fa-solid fa-globe\"></i></span>\n                    <ul><li class=\"trp-language-switcher-container menu-item menu-item-type-post_type menu-item-object-language_switcher menu-item-has-children current-language-menu-item menu-item-191\"><a href=\"https://gateway-hotel.co.jp/en/guest\"><span data-no-translation><span class=\"trp-ls-language-name\">EN</span></span></a>\n<ul class=\"sub-menu\">\n\t<li class=\"trp-language-switcher-container menu-item menu-item-type-post_type menu-item-object-language_switcher menu-item-190\"><a href=\"https://gateway-hotel.co.jp/guest/\"><span data-no-translation><span class=\"trp-ls-language-name\">JA</span></span></a></li>\n\t<li class=\"trp-language-switcher-container menu-item menu-item-type-post_type menu-item-object-language_switcher menu-item-188\"><a href=\"https://gateway-hotel.co.jp/zh/guest/\"><span data-no-translation><span class=\"trp-ls-language-name\">ZH</span></span></a></li>\n</ul>\n</li>\n</ul>                    </div>\n  </div></li>\n    <li>\n      <div class=\"head_btn\"><a href=\"https://gateway-hotel.co.jp/en/inquiry\">inquiry</a></div>\n    </li>\n    <li>\n      <div class=\"head_btn_blk m_l_2 m_l_0_sp\"><a href=\"https://gateway-hotel.co.jp/en/group-inquiry\">Group Reservation Information</a></div>\n    </li>\n  </ul>\n</nav>\n</div>\n</header>\n      <div class=\"cont_wrap p_0\">\r\n\t<div class=\"page_title_cont bg_p_facility\"><div class=\"page_title_box js-anim\">Facilities &amp; Services<span>Facility Information</span></div></div>\r\n</div>\r\n<div class=\"cont_sec_wrap bg_gry\">\r\n  <div class=\"container\">\r\n          <h2 class=\"cont_title\">Facility<span>facility</span></h2>\r\n\t  <ul class=\"attractions_archive\">\r\n\t\t  <li>\r\n\t\t\t  <div class=\"attractions_img\"><img decoding=\"async\" src=\"https://gateway-hotel.co.jp/wp/wp-content/uploads/2026/04/ファミリーマート-写真.jpg\" alt=\"ファミリーマート\"></div>\r\n\t\t\t  <div class=\"attractions_detail jc_fs\">\r\n\t\t\t\t  <div class=\"attractions_card_title\">\r\n\t\t\t\t\t  <h3>FamilyMart Narita Gateway Hotel Store</h3>\r\n\t\t\t\t\t  <div class=\"attractions_no\">01</div>\r\n\t\t\t\t  </div>\r\n\t\t\t\t  <p class=\"font14\">We offer a wide variety of snacks, bread, drinks, alcoholic beverages, daily necessities, travel items, souvenirs, and more to help you have a comfortable stay.</p>\r\n\t\t\t\t  <div class=\"facility_detail\">\r\n\t\t\t\t\t  Location: 2nd floor lobby<br>\r\n\t\t\t\t\t  Opening hours: 24 hours\r\n\t\t\t\t  </div>\r\n        \r\n\t\t\t  </div>\r\n\t\t  </li>\r\n\t\t  <li>\r\n\t\t\t  <div class=\"attractions_img\"><img decoding=\"async\" src=\"https://gateway-hotel.co.jp/wp/wp-content/themes/narita2025/img/guest02.webp\" alt=\"ゲートカフェ\"></div>\r\n\t\t\t  <div class=\"attractions_detail jc_fs\">\r\n\t\t\t\t  <div class=\"attractions_card_title\">\r\n\t\t\t\t\t  <h3>Gate Cafe</h3>\r\n\t\t\t\t\t  <div class=\"attractions_no\">02</div>\r\n\t\t\t\t  </div>\r\n\t\t\t\t  <p class=\"font14\">We offer drinks and meals in our open lounge. We have a wide variety of gelato, drinks, and food on the menu, so please feel free to come and enjoy.</p>\r\n\t\t\t\t  <div class=\"facility_detail\">\r\n\t\t\t\t\t  Location: 2nd floor lounge<br>\r\n\t\t\t\t\t  Business hours: 17:00-23:00<br>\r\n\t\t\t\t\t  *Take-out available\r\n\t\t\t\t  </div>\r\n        \r\n\t\t\t  </div>\r\n\t\t  </li>\r\n\t\t  <li>\r\n\t\t\t  <div class=\"attractions_img\"><img decoding=\"async\" src=\"https://gateway-hotel.co.jp/wp/wp-content/themes/narita2025/img/guest03.webp\" alt=\"フィットネスジム\"></div>\r\n\t\t\t  <div class=\"attractions_detail jc_fs\">\r\n\t\t\t\t  <div class=\"attractions_card_title\">\r\n\t\t\t\t\t  <h3>fitness gym</h3>\r\n\t\t\t\t\t  <div class=\"attractions_no\">03</div>\r\n\t\t\t\t  </div>\r\n\t\t\t\t  <p class=\"font14\">Guests staying at the hotel are welcome to use the facility freely. We do not provide rental wear.</p>\r\n\t\t\t\t  <div class=\"facility_detail\">\r\n\t\t\t\t\t  Location: 1F<br>\r\n\t\t\t\t\t  Available: 24 hours\r\n\t\t\t\t  </div>\r\n\t\t\t\t  \r\n        \r\n\t\t\t  </div>\r\n\t\t  </li>\r\n\t\t  <li>\r\n\t\t\t  <div class=\"attractions_img\"><img decoding=\"async\" src=\"https://gateway-hotel.co.jp/wp/wp-content/themes/narita2025/img/guest04.webp\" alt=\"コインランドリー\"></div>\r\n\t\t\t  <div class=\"attractions_detail jc_fs\">\r\n\t\t\t\t  <div class=\"attractions_card_title\">\r\n\t\t\t\t\t  <h3>Coin laundry</h3>\r\n\t\t\t\t\t  <div class=\"attractions_no\">04</div>\r\n\t\t\t\t  </div>\r\n\t\t\t\t  <p class=\"font14\">We have a coin laundry in the building, which is convenient for long-term stays or for sudden laundry needs. We also sell detergent, so please feel free to ask.</p>\r\n\t\t\t\t  <div class=\"facility_detail\">\r\n\t\t\t\t\t  Location: 1F<br>\r\n\t\t\t\t\t  Washing machines: 3 units, 300 yen/use<br>\r\n\t\t\t\t\t  Dryer: 3 units ¥100/30 minutes<br>\r\n\t\t\t\t\t  (Detergent vending machine available, 100 yen/unit)\r\n\t\t\t\t  </div>\r\n\t\t\t  </div>\r\n\t\t  </li>\r\n\t\t  <li>\r\n\t\t\t  <div class=\"attractions_img\"><img decoding=\"async\" src=\"https://gateway-hotel.co.jp/wp/wp-content/themes/narita2025/img/guest05.webp\" alt=\"外貨両替機\"></div>\r\n\t\t\t  <div class=\"attractions_detail jc_fs\">\r\n\t\t\t\t  <div class=\"attractions_card_title\">\r\n\t\t\t\t\t  <h3>foreign currency exchange machine</h3>\r\n\t\t\t\t\t  <div class=\"attractions_no\">05</div>\r\n\t\t\t\t  </div>\r\n\t\t\t\t  <p class=\"font14\">A foreign currency exchange machine is available next to the front desk on the second floor of our hotel. The following major currencies can be exchanged for Japanese yen.</p>\r\n\t\t\t\t  <div class=\"facility_detail\">\r\n\t\t\t\t\t  Location: 2nd floor, next to the front desk<br>\r\n\t\t\t\t\t  Foreign currencies accepted:<br>US dollar / Euro / British pound / Chinese yuan / South Korean won / Hong Kong dollar / Taiwan dollar / Singapore dollar / Thai baht / Malaysian ringgit / Australian dollar / Philippine peso\r\n\t\t\t\t  </div>\r\n\t\t  </li>\r\n\t\t  <li>\r\n\t\t\t  <div class=\"attractions_img\"><img decoding=\"async\" src=\"https://gateway-hotel.co.jp/wp/wp-content/uploads/2026/01/smoking.webp\" alt=\"喫煙室\"></div>\r\n\t\t\t  <div class=\"attractions_detail jc_fs\">\r\n\t\t\t\t  <div class=\"attractions_card_title\">\r\n\t\t\t\t\t  <h3>Smoking room</h3>\r\n\t\t\t\t\t  <div class=\"attractions_no\">06</div>\r\n\t\t\t\t  </div>\r\n\t\t\t\t  <p class=\"font14\">Smoking is prohibited throughout the entire building except for the designated smoking room. Please use the designated smoking area if you wish to smoke.</p>\r\n\t\t\t\t  <div class=\"facility_detail\">\r\n\t\t\t\t\t  Location: 2nd floor lobby<br>Available 24 hours\r\n\t\t\t\t  </div>\r\n\t\t\t  </div>\r\n\t\t  </li>\r\n\t\t  <li>\r\n\t\t\t  <div class=\"attractions_img\"><img decoding=\"async\" src=\"https://gateway-hotel.co.jp/wp/wp-content/themes/narita2025/img/guest07.webp\" alt=\"お子様アメニティ\"></div>\r\n\t\t\t  <div class=\"attractions_detail jc_fs\">\r\n\t\t\t\t  <div class=\"attractions_card_title\">\r\n\t\t\t\t\t  <h3>Children&#039;s amenities</h3>\r\n\t\t\t\t\t  <div class=\"attractions_no\">07</div>\r\n\t\t\t\t  </div>\r\n\t\t\t\t  <p class=\"font14\">We have added new items to our fleet so that parents with small children can enjoy their trip with peace of mind.In addition to baby beds and children&#039;s tableware, we also provide baby baths and toys, so your children will feel at home.</p>\r\n\t\t\t\t  <div class=\"facility_detail\">\r\n\t\t\t\t\t  [Children&#039;s items]<br>Small toys, baby bath, bottle warmer, baby bed (fee required), crayons &amp; coloring books, picture books<br><br>\r\n\t\t\t\t\t  [Children&#039;s items for restaurants]<br>Chairs, children&#039;s tableware, bibs\r\n\t\t\t\t  </div>\r\n\t\t\t  </div>\r\n\t\t  </li>\r\n\t\t  <li>\r\n\t\t\t  <div class=\"attractions_img\"><img decoding=\"async\" src=\"https://gateway-hotel.co.jp/wp/wp-content/themes/narita2025/img/guest08.webp\" alt=\"ビジネスサポート\"></div>\r\n\t\t\t  <div class=\"attractions_detail jc_fs\">\r\n\t\t\t\t  <div class=\"attractions_card_title\">\r\n\t\t\t\t\t  <h3>Business Support</h3>\r\n\t\t\t\t\t  <div class=\"attractions_no\">08</div>\r\n\t\t\t\t  </div>\r\n\t\t\t\t  <p class=\"font14\">We offer convenient copy and fax services for business use at the front desk. Please ask the front desk staff if you need them.</p>\r\n\t\t\t\t  <div class=\"facility_detail\">\r\n\t\t\t\t\t  Copy: ¥20 per sheet (black and white only)<br>Fax: 100 yen per page\r\n\t\t\t\t  </div>\r\n\t\t\t  </div>\r\n\t\t  </li>\r\n\t\t  <li>\r\n\t\t\t  <div class=\"attractions_img\"><img decoding=\"async\" src=\"https://gateway-hotel.co.jp/wp/wp-content/themes/narita2025/img/guest09.webp\" alt=\"インターネット\"></div>\r\n\t\t\t  <div class=\"attractions_detail jc_fs\">\r\n\t\t\t\t  <div class=\"attractions_card_title\">\r\n\t\t\t\t\t  <h3>internet</h3>\r\n\t\t\t\t\t  <div class=\"attractions_no\">09</div>\r\n\t\t\t\t  </div>\r\n\t\t\t\t  <p class=\"font14\">Free Wi-Fi is available in all guest rooms, conference rooms, and the 2nd floor lobby. Please ask our staff for more information.</p>\r\n\t\t\t\t  <div class=\"facility_detail\">\r\n\t\t\t\t\t  Available: 24 hours\r\n\t\t\t\t  </div>\r\n\t\t\t  </div>\r\n\t\t  </li>\r\n\t\t  <li>\r\n\t\t\t  <div class=\"attractions_img\"><img decoding=\"async\" src=\"https://gateway-hotel.co.jp/wp/wp-content/themes/narita2025/img/guest10.webp\" alt=\"その他\"></div>\r\n\t\t\t  <div class=\"attractions_detail jc_fs\">\r\n\t\t\t\t  <div class=\"attractions_card_title\">\r\n\t\t\t\t\t  <h3>others</h3>\r\n\t\t\t\t\t  <div class=\"attractions_no\">10</div>\r\n\t\t\t\t  </div>\r\n\t\t\t\t  <p class=\"font14\">We have installed facilities on each floor to make your stay more comfortable. Please feel free to use them.</p>\r\n\t\t\t\t  <div class=\"facility_detail\">\r\n\t\t\t\t\t  Vending machines: 2nd to 9th floors<br>\r\n\t\t\t\t\t  Ice machines: 3F/4F/6F/7F/9F<br>\r\n\t\t\t\t\t  Microwave: 1F<br>\r\n\t\t\t\t\t  Baggage scales: 2F\r\n\t\t\t\t  </div>\r\n\t\t\t  </div>\r\n\t\t  </li>\r\n\t  </ul>\r\n</div>\r\n</div>\r\n<div class=\"cont_sec_wrap\">\r\n  <div class=\"container\">\r\n          <h3 class=\"cont_title_sub m_t_0\"><div>basic information<br><span>Basic Information</span></div></h3>\r\n\t  <table class=\"op_tbl js-anim is-animated\">\r\n  <tbody>\r\n\t  <tr>\r\n    <th>Total number of rooms</th>\r\n    <td>307 rooms<br>Single: 80 rooms<br>Economy twin: 63 rooms<br>Twin: 132 rooms<br>Double: 13 rooms<br>Triple: 6 rooms<br>Suites: 13\r\n</td>\r\n  </tr>\r\n\t  <tr>\r\n    <th>parking</th>\r\n    <td>Approximately 100 standard-sized cars: 15:00 to 11:00 the next day, 400 yen/night (cannot be used outside of the accommodation period)<br><br>\r\n\t4 large bus spaces: 2,000 yen/night (reservation required)\r\n</td>\r\n  </tr>\r\n\t  <tr>\r\n    <th>Amenities</th>\r\n    <td>■ Each room<br>Shampoo / Conditioner / Hand soap<br>■ 2nd floor lobby amenity corner<br>Toothbrush / Razor / Hairbrush / Body sponge / Cotton swab / Sencha\r\n\r\n</td>\r\n  </tr>\r\n\t  <tr>\r\n    <th>Rental equipment</th>\r\n    <td>Humidifier/air purifier / electric fan / desk lamp / iron / ironing board / trouser press / baby bath / bottle warmer / baby bed (¥2,000/unit) / bed guard / wheelchair\r\n\r\n</td>\r\n  </tr>\r\n\t  <tr>\r\n    <th>Check-in and check-out</th>\r\n    <td>■ Check-in: from 15:00<br>■ Check-out: until 11:00<br>(※ According to the accommodation plan)<br><br>■ Early check-in: 11:00-15:00 → ¥1,000/hour (maximum check-in time is 11:00)<br>■ Late check-out: 11:00-15:00 → ¥1,000/hour (maximum until 15:00)<br>(※ We may decline your request depending on room availability.)\r\n</td>\r\n  </tr>\r\n  <tr class=\"last\">\r\n    <th>others</th>\r\n    <td>All rooms are non-smoking. If you smoke, please use the smoking booth located in the lobby on the second floor.<br>If we find that you have smoked or brought something into the room, we will charge you 20,000 yen as a cleaning fee.\r\n</td></tr>\r\n</tbody></table>\r\n</div>\r\n</div>  \n\n<div class=\"bg_bestrate\">\n  <div class=\"container\">\n    <div class=\"bestrate_img js-anim\"><img src=\"https://gateway-hotel.co.jp/wp/wp-content/themes/narita2025/img/bestrate_img.webp\" alt=\"ベストレート\"></div>\n    <p class=\"bestrate_txt\">You can get great deals by booking your stay on the official hotel website!</p>\n    <div class=\"main_btn m_auto p_t_3\"><a href=\"https://gateway-hotel.co.jp/en/bestrate\" class=\"arrow\">Learn more</a></div>\n  </div>\n</div>\n<footer>\n  <div class=\"foot_cont\">\n    <div class=\"f_cont_logo\"><a href=\"https://gateway-hotel.co.jp/en/\"><img src=\"https://gateway-hotel.co.jp/wp/wp-content/themes/narita2025/img/footer_logo.webp\" alt=\"成田ゲートウェイホテル\"></a></div>\n    <div class=\"\">\n      <ul class=\"f_cont_menu p_b_0 bold p_b_3_sp\">\n        <li><a href=\"https://gateway-hotel.co.jp/en/room\">Accommodation</a></li>\n        <li><a href=\"https://gateway-hotel.co.jp/en/restaurant\">restaurant</a></li>\n        <li><a href=\"https://gateway-hotel.co.jp/en/guest\">Facility Information</a></li>\n        <li><a href=\"https://gateway-hotel.co.jp/en/access\">access</a></li>\n        <li><a href=\"https://gateway-hotel.co.jp/en/surround\">Tourist Information</a></li>\n        <li><a href=\"https://gateway-hotel.co.jp/en/inquiry\">inquiry</a></li>\n      </ul>\n      <ul class=\"f_cont_menu fw300\">\n        <li><a href=\"https://gateway-hotel.co.jp/en/conference\">Meetings and banquets</a></li>\n        <li><a href=\"https://gateway-hotel.co.jp/en/news\">notice</a></li>\n        <li><a href=\"https://gateway-hotel.co.jp/en/bestrate\">Best Rate</a></li>\n        <li><a href=\"https://gateway-hotel.co.jp/en/group-inquiry\">Group Reservation Information</a></li>\n        <li><a href=\"https://gateway-hotel.co.jp/en/faq\">Frequently asked questions</a></li>\n        <li><a href=\"https://recruit.gateway-hotel.co.jp/\">Recruitment Information</a></li>\n      </ul>\n    </div>\n  </div>\n</footer>\n<div class=\"cont_wrap bg_blk p_t